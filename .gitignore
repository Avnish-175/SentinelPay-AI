# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Large Datasets (>100MB exceeds GitHub push limit)
data/raw/
data/processed/*.csv
data/splits/
*.csv
!reports/*.csv
!data/processed/fraud_*.csv

# Preprocessed artifacts & model dumps if large
models/baseline/*.joblib
data/artifacts/preprocessing/*.joblib

# Node dependencies & Vite build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Java Maven build outputs
target/
backend/target/
*.class

# Environment files and secrets (preserve .env.example)
.env
.env.local
.env.*.local
frontend/.env
!frontend/.env.example
!*.env.example

# Logs and debug artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
